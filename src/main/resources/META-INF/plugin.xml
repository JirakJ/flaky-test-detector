<idea-plugin>
    <id>com.jakubjirak.flakytestdetector</id>
    <product-descriptor code="PFLAKYTESTDTCTR" release-date="20260215" release-version="20262" optional="true"/>
    <name>Flaky Test Detector</name>
    <vendor email="jakub@jirak.dev" url="https://github.com/jakubjirak">Jakub Jirák</vendor>

    <description><![CDATA[
<h2>Flaky Test Detector</h2>
<p>
  Flaky tests erode team confidence and waste CI minutes. Flaky Test Detector automatically tracks test
  execution history, calculates flakiness scores, and surfaces unstable tests with visual gutter icons
  and a sortable dashboard — so you can fix or quarantine them fast.
</p>

<h2>Key Features</h2>
<ul>
  <li><b>Automatic History Tracking</b> — Records pass/fail outcomes for every test execution</li>
  <li><b>Flakiness Score</b> — Percentage-based score calculated from execution history</li>
  <li><b>Gutter Icons</b> — Inline visual indicators showing test stability at a glance</li>
  <li><b>Sortable Dashboard</b> — Table view with sparkline charts, filterable by score and status</li>
  <li><b>Quarantine Marking</b> — Flag flaky tests and rerun them separately</li>
  <li><b>Test Recording</b> — Captures execution details for root cause analysis</li>
</ul>

<h2>Why Flaky Test Detector?</h2>
<p>
  Studies show that up to 16% of tests in large codebases are flaky. This plugin transforms flaky test
  management from guesswork into data-driven decision making.
</p>

<h2>Free vs Pro</h2>
<ul>
  <li><b>Free:</b> Up to 500 tests, 30-day history, flakiness scores, gutter icons, dashboard</li>
  <li><b>Pro ($5/month):</b> Unlimited tests, extended history, trend charts, JSON/CSV/HTML export, git correlation analysis, auto-quarantine rules, and CI/CD integration</li>
</ul>
]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <projectService
                serviceImplementation="com.jakubjirak.flakytestdetector.storage.FlakyTestStorage"/>

        <toolWindow
                id="Flaky Tests"
                anchor="bottom"
                secondary="true"
                icon="AllIcons.Nodes.JunitTestMark"
                factoryClass="com.jakubjirak.flakytestdetector.ui.FlakyTestToolWindowFactory"/>

        <applicationConfigurable
                id="com.jakubjirak.flakytestdetector.settings"
                parentId="tools"
                displayName="Flaky Test Detector"
                instance="com.jakubjirak.flakytestdetector.settings.FlakyTestConfigurable"/>

        <applicationService
                serviceImplementation="com.jakubjirak.flakytestdetector.settings.FlakyTestSettings"/>

        <applicationService
                serviceImplementation="com.jakubjirak.flakytestdetector.core.FreemiumGate"/>

        <testStatusListener
                implementation="com.jakubjirak.flakytestdetector.listener.FlakyTestExecutionListener"/>

        <projectActivity
                implementation="com.jakubjirak.flakytestdetector.FlakyTestStartupActivity"/>

        <notificationGroup
                id="Flaky Test Detector"
                displayType="BALLOON"
                toolWindowId="Flaky Tests"/>
    </extensions>

    <actions>
        <action id="com.jakubjirak.flakytestdetector.RerunFlakyTests"
                class="com.jakubjirak.flakytestdetector.actions.RerunFlakyTestsAction"
                text="Rerun Flaky Tests"
                description="Rerun all tests with non-zero flakiness score"
                icon="AllIcons.Actions.Rerun">
            <keyboard-shortcut first-keystroke="alt shift F" keymap="$default"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>

        <action id="com.jakubjirak.flakytestdetector.QuarantineTest"
                class="com.jakubjirak.flakytestdetector.actions.QuarantineTestAction"
                text="Quarantine Test"
                description="Toggle quarantine status on the selected test"
                icon="AllIcons.Actions.Pause">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>

        <action id="com.jakubjirak.flakytestdetector.ViewHistory"
                class="com.jakubjirak.flakytestdetector.actions.ViewHistoryAction"
                text="View Flaky Test History"
                description="Open the Flaky Tests tool window"
                icon="AllIcons.Actions.Preview">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>

        <action id="com.jakubjirak.flakytestdetector.ClearHistory"
                class="com.jakubjirak.flakytestdetector.actions.ClearHistoryAction"
                text="Clear Flaky Test History"
                description="Clear all recorded test history"
                icon="AllIcons.Actions.GC">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
