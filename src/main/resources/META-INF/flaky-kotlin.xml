<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <codeInsight.lineMarkerProvider language="kotlin"
                implementationClass="com.jakubjirak.flakytestdetector.ui.FlakyGutterIconProvider"/>
    </extensions>
    <!-- Uses only platform PSI APIs, so it works in both K1 and K2 Kotlin plugin modes. -->
    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true"/>
    </extensions>
</idea-plugin>
